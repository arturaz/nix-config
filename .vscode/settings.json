{
  // Nix IDE (jnoortheen.nix-ide) with nixd; nixd and nixfmt come from the Nix user
  // profile (nix profile add nixpkgs#nixd nixpkgs#nixfmt).
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": ["nixfmt"]
      },
      // `path:` so new files are seen before they're committed (a git flake only sees
      // files in git's index, and jj doesn't add them there).
      "nixpkgs": {
        "expr": "import (builtins.getFlake \"path:${workspaceFolder}\").inputs.nixpkgs { }"
      },
      "options": {
        // All hosts share the same nixpkgs, so any host's options cover all of them.
        "nixos": {
          "expr": "(builtins.getFlake \"path:${workspaceFolder}\").nixosConfigurations.tv-box.options"
        }
      }
    }
  },
  "cSpell.words": [
    "Addrs",
    "alsa",
    "anytype",
    "arturas",
    "Artūras",
    "arturaz",
    "attrsets",
    "bindgen",
    "bitwarden",
    "bson",
    "busctl",
    "cdylib",
    "chown",
    "conntrack",
    "ctstate",
    "dbpath",
    "dport",
    "dports",
    "libvalkey",
    "loadmodule",
    "mongod",
    "mongodb",
    "mongosh",
    "multiport",
    "netlink",
    "networkmanager",
    "nixd",
    "nixfmt",
    "nixos",
    "nixpkgs",
    "NOFILE",
    "norc",
    "oneshot",
    "pipewire",
    "pkgs",
    "pulseaudio",
    "QUIC",
    "rederive",
    "replset",
    "restic",
    "rsync",
    "rsynced",
    "rtkit",
    "Sandboxing",
    "sftp",
    "Šlajus",
    "sops",
    "sshd",
    "toplevel",
    "Tunables",
    "valkey",
    "vendorhash",
    "virtualisation",
    "yamux",
    "zstd"
  ]
}
